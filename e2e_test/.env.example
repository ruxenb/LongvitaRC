# Copy this file to e2e_test/.env. Never commit the real .env file.
ARTEMIS_BASE_URL=http://127.0.0.1:8000
ANDROID_SERIAL=emulator-5554
ARTEMIS_PROFILE=flash

# Google account the auth cases sign in with; it must be on the device.
# Put the real address only in e2e_test/.env, never in this file.
ARTEMIS_TEST_ACCOUNT=test.account@example.com

# AI Models for ARTEMIS
ARTEMIS_FLASH_MODEL=gemini-3.5-flash-lite
ARTEMIS_PRO_MODEL=gemini-3.8-flash

# Test data prepared manually before the relevant FCM scenario.
FCM_TEST_TITLE=Longvita test notification
