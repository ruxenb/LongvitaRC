rules_version = '2';

// PRM393 Lab 3: Storage Security Rules for Longvita
// Security rule requirement: Each user can only read and write under their own folder: reports/{uid}/...
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated users can access their own reports directory
    match /reports/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
